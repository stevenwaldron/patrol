# Argo CD install settings: Helm chart argo-cd 10.11.6 = Argo CD v3.5.6.
# Installed by infra/up.sh (helm upgrade --install). Argo CD then installs
# everything else in the cluster from Git (deploy/argocd/root-app.yaml).

global:
  # The dashboard is private: reached only with kubectl port-forward from the
  # admin's machine, never through a public load balancer.
  domain: localhost:8080

configs:
  cm:
    # Check Git for changes every 2 minutes (± up to 1 minute of jitter).
    timeout.reconciliation: 120s
    # Make Argo CD wait for each child Application to be HEALTHY before moving to
    # the next sync wave. Argo CD doesn't assess Application health by default
    # (since v1.8), so without this, sync waves between apps would only order
    # creation, not wait for readiness. Here: the load balancer controller must
    # be running before Patrol's pods are created (its webhook adds the ALB
    # readiness gate to them).
    resource.customizations.health.argoproj.io_Application: |
      hs = {}
      hs.status = "Progressing"
      hs.message = ""
      if obj.status ~= nil then
        if obj.status.health ~= nil then
          hs.status = obj.status.health.status
          if obj.status.health.message ~= nil then
            hs.message = obj.status.health.message
          end
        end
      end
      return hs

# Not needed here: single sign-on (Dex) and notifications. Off = less memory,
# fewer moving parts. Slack alerts come from Alertmanager in Phase 5.
dex:
  enabled: false
notifications:
  enabled: false

server:
  service:
    type: ClusterIP
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits: { memory: 256Mi }

controller:
  resources:
    requests: { cpu: 100m, memory: 256Mi }
    limits: { memory: 512Mi }

repoServer:
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits: { memory: 512Mi }

applicationSet:
  resources:
    requests: { cpu: 25m, memory: 64Mi }
    limits: { memory: 128Mi }

redis:
  resources:
    requests: { cpu: 25m, memory: 64Mi }
    limits: { memory: 128Mi }
